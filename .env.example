EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
EXPO_PUBLIC_API_URL=http://localhost:3000

# Android Google Maps key for react-native-maps (MapScreen). Not needed on iOS
# (Apple Maps). Restrict the key to the Maps SDK for Android + the app's package
# (com.localloop.app) + SHA-1 in Google Cloud Console. Consumed at prebuild/build.
GOOGLE_MAPS_API_KEY=<your-android-google-maps-key>
